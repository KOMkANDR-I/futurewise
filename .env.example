# FUTUREWISE — пример переменных окружения.
# Скопируйте файл в .env.local и заполните. Без ключа приложение работает
# полностью: AI-объяснения формируются локальными шаблонами из расчётов.

# Провайдер: anthropic | openai  (openai = любой OpenAI-совместимый Chat Completions API)
AI_PROVIDER=anthropic

# Ключ хранится только на сервере (Route Handler /api/explain), в браузер не попадает.
AI_API_KEY=

# Модель. Для anthropic, например: claude-sonnet-5-5
AI_MODEL=claude-sonnet-5-5

# Только для AI_PROVIDER=openai: базовый URL совместимого API
# AI_BASE_URL=https://api.openai.com/v1
